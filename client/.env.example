# Bot WebSocket (live captions / status / summaries)
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Bot HTTP API (sessions, transcripts, summaries) — bot HTTP_PORT (default 8081)
NEXT_PUBLIC_API_URL=http://localhost:8081

# Optional shared token the WS server requires as ?token= (matches bot WS_AUTH_TOKEN)
NEXT_PUBLIC_WS_TOKEN=
