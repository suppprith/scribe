# Bot WebSocket (live captions / status / summaries)
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Bot HTTP API (sessions, transcripts, summaries).
# The bot currently serves /health on the WebSocket port; a dedicated HTTP API
# (default port 8081) lands with later Phase 4 tickets — point this at it then.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional shared token the WS server requires as ?token= (matches bot WS_AUTH_TOKEN)
NEXT_PUBLIC_WS_TOKEN=
