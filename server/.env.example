SERVICE_NAME=scribe-nlp
HOST=0.0.0.0
PORT=8000

# faster-whisper ASR (used from Phase 2 onward). Tuned for an 8GB-RAM CPU host.
# Two tiers: a fast model for live captions, a more accurate one for the final
# pass. English-only (.en) by default; switch to multilingual models for
# translation (Phase 7).
WHISPER_MODEL_LIVE=base.en
WHISPER_MODEL_FINAL=small.en
DEVICE=cpu
COMPUTE_TYPE=int8
