SERVICE_NAME=scribe-nlp
HOST=0.0.0.0
PORT=8000

# faster-whisper ASR. Tuned for an 8GB-RAM CPU host (int8). Two tiers: a fast
# model for live captions, a more accurate one for the final pass. Defaults are
# MULTILINGUAL so English, Hindi, and Thai all work. For an English-only server
# you can switch to the faster .en models (e.g. WHISPER_MODEL_LIVE=base.en).
WHISPER_MODEL_LIVE=base
WHISPER_MODEL_FINAL=small
DEVICE=cpu
COMPUTE_TYPE=int8

# ASR behaviour
ASR_DEFAULT_LANGUAGE=auto
ASR_BEAM_SIZE=5
ASR_MIN_AUDIO_MS=200
ASR_SILENCE_PEAK=0.01
