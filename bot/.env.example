# --- Discord ---
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) id, used to register slash commands
DISCORD_CLIENT_ID=
# Optional: register commands to a single guild for fast iteration during dev
DISCORD_DEV_GUILD_ID=

# --- NLP service (server/) ---
SERVER_URL=http://localhost:8000

# --- WebSocket server (bot -> client live captions) ---
WS_PORT=8080

# --- SQLite ---
DATABASE_PATH=./data/scribe.db
