# --- Discord (DISCORD_TOKEN is required; the bot exits at boot without it) ---
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) id — used to register slash commands (Phase 1)
DISCORD_CLIENT_ID=
# Optional: register commands to a single guild for fast iteration during dev
DISCORD_DEV_GUILD_ID=

# --- NLP service (server/) ---
NLP_SERVICE_URL=http://localhost:8000

# --- Networking ---
# WebSocket: live captions / status / summaries -> client
WS_PORT=8080
# Optional shared token clients must pass (?token=...) to connect to the WS
WS_AUTH_TOKEN=
# HTTP API: sessions / transcripts / summaries -> client
HTTP_PORT=8081

# --- SQLite ---
DB_PATH=./data/scribe.db

# --- Google Drive (OAuth2; optional — uploads session artifacts if configured) ---
# Set client id/secret below, then run `bun run auth:google` to mint the refresh
# token (authorized redirect URI: http://localhost:53682). See bot/README.md.
# Leave these blank to disable Drive storage entirely.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional: nest all uploads under this existing Drive folder id.
GOOGLE_DRIVE_FOLDER_ID=
